---
import type { IconName } from '../../lib/icons.ts';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: cls = '' } = Astro.props;
---

<svg
  class={`md-icon ${cls}`}
  width={size}
  height={size}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'qr_code' && (
    <>
      <rect x="3" y="3" width="7" height="7" rx="1.5" />
      <rect x="14" y="3" width="7" height="7" rx="1.5" />
      <rect x="3" y="14" width="7" height="7" rx="1.5" />
      <path d="M14 14h3v3h-3zM20 14h1M14 20h1M18 18h3v3h-3z" />
    </>
  )}
  {name === 'qr_code_scanner' && (
    <>
      <path d="M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3" />
      <rect x="7" y="7" width="4" height="4" rx="1" />
      <rect x="13" y="13" width="4" height="4" rx="1" />
      <path d="M13 7h1M7 13h1M17 17h4M7 17h1" />
    </>
  )}
  {name === 'flash_on' && (
    <path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12L13 2z" />
  )}
  {name === 'flash_off' && (
    <>
      <path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12L13 2z" />
      <line x1="3" y1="3" x2="21" y2="21" />
    </>
  )}
  {name === 'cameraswitch' && (
    <>
      <path d="M5 9.5h2.8l1.4-2.2h5.6l1.4 2.2H19a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z" />
      <g stroke-width="2.4">
        <path d="M7.8 16A4.8 4.8 0 0 1 16.2 13.8" />
        <path d="M16.2 11.4v2.4h-2.4" />
        <path d="M16.2 14.2A4.8 4.8 0 0 1 7.8 16.4" />
        <path d="M7.8 18.8v-2.4h2.4" />
      </g>
    </>
  )}
  {name === 'upload' && (
    <>
      <path d="M12 16V4M7 9l5-5 5 5" />
      <path d="M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2" />
    </>
  )}
  {name === 'history' && (
    <>
      <path d="M3.5 12a8.5 8.5 0 1 1 2.5 6" />
      <path d="M3.5 12H7M3.5 12V8.5" />
      <path d="M12 7.5V12l3.2 2" />
    </>
  )}
  {name === 'close' && (
    <>
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="18" y1="6" x2="6" y2="18" />
    </>
  )}
  {name === 'copy' && (
    <>
      <rect x="9" y="9" width="12" height="12" rx="2" />
      <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
    </>
  )}
  {name === 'share' && (
    <>
      <circle cx="18" cy="5" r="2.5" />
      <circle cx="6" cy="12" r="2.5" />
      <circle cx="18" cy="19" r="2.5" />
      <path d="M8.2 10.8 15.7 6.4M8.2 13.2l7.5 4.4" />
    </>
  )}
  {name === 'open_in_new' && (
    <>
      <path d="M14 4h6v6" />
      <path d="M20 4 11 13" />
      <path d="M19 13.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5.5" />
    </>
  )}
  {name === 'delete' && (
    <>
      <path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M6.5 7l1 13a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1l1-13" />
      <line x1="10" y1="11" x2="10" y2="17" />
      <line x1="14" y1="11" x2="14" y2="17" />
    </>
  )}
  {name === 'install' && (
    <>
      <path d="M12 4v11M7.5 11 12 15.5 16.5 11" />
      <path d="M4 19.5h16" />
    </>
  )}
  {name === 'image' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <circle cx="9" cy="10" r="1.6" />
      <path d="M4.5 18 10 12.5l3.5 3.5 2.5-2.5 3.5 3.5" />
    </>
  )}
  {name === 'check' && (
    <path d="M4.5 12.5 10 18 19.5 6.5" />
  )}
  {name === 'videocam_off' && (
    <>
      <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h11A1.5 1.5 0 0 1 17 6.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 13.5v-7z" />
      <path d="M17 10.5 21 7.5v9l-4-3" />
      <line x1="3" y1="3" x2="21" y2="21" />
    </>
  )}
</svg>

<style>
  .md-icon {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
